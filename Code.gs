const TABS=["Athlete_Profile", "Testing_Sessions", "Performance_Metrics", "Normative_Data", "Coach_Recommendations", "Areas_of_Focus", "Next_Steps", "Dashboard_Settings", "Recommendation Matrix", "Status Logic", "RVX App Programs", "Dashboard Lookup Guide", "Dropdown_Lists", "Recommendation_Output", "Recommendation_Lookup"];function doGet(e){const token=PropertiesService.getScriptProperties().getProperty('RVX_APPS_SCRIPT_TOKEN');if(token&&e.parameter.token!==token)return out({error:'Unauthorized'});const ss=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('RVX_GOOGLE_SHEET_ID'));const p={};TABS.forEach(n=>{const v=ss.getSheetByName(n).getDataRange().getDisplayValues(),h=v.shift();p[n]=v.filter(r=>r.some(x=>x!=='' )).map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])))});return out(p)}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
